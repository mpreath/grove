<article>
  <header class="post-header">
    <h1><%= page.title %></h1>
    <div class="post-meta">
      <% if page.date %>
        <time datetime="<%= page.date %>"><%= page.date.strftime("%B %-d, %Y") %></time>
      <% end %>
      <% unless page.tags.empty? %>
        <span class="tags">
          <% page.tags.each do |tag| %>
            <a href="<%= root_relative("tags/#{tag_slug(tag)}/") %>">#<%= tag %></a>
          <% end %>
        </span>
      <% end %>
    </div>
  </header>

  <div class="post-body">
    <%= page.body_html %>
  </div>
</article>
